Cell[BoxData[
 RowBox[{"letnaVolatilnost", " ", "=", " ", 
  RowBox[{"volatilnost", "*", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Length", "[", "donos", "]"}], "]"}]}]}]], "Input",
