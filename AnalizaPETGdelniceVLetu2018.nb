Notebook[{

Cell[CellGroupData[{
Cell["Analiza delnic PETG v letu 2018", "Title",
 CellChangeTimes->{{3.9629556113563404`*^9, 3.9629556250841866`*^9}, {
  3.965379190854246*^9, 
  3.9653791942752857`*^9}},ExpressionUUID->"5c1b1491-1ce5-e348-ab41-\
510ec1a18ab2"],

Cell[CellGroupData[{

Cell["Pridobivanje podatkov", "Section",
 CellChangeTimes->{{3.965379205775566*^9, 3.965379215567333*^9}, 
   3.9653797717284126`*^9, 
   3.9653798089024296`*^9},ExpressionUUID->"dfafe5f9-74b1-e14d-bc50-\
7294cb94e303"],

Cell["\<\
Podatke sem pridobil iz spletne strani https://www.ljse.si/ . V navodilu \
naloge je re\[CHacek]eno naj analiziram delnico PETG za leto 2017, ampak ker
podatkov za to leto nisem na\[SHacek]el, sem naredil za leto 2018.

Nastavimo delovni direktorij na direktorij v katerem imam podatke o delnici.\
\>", "Text",
 CellChangeTimes->{{3.9653793396508503`*^9, 
  3.965379474752493*^9}},ExpressionUUID->"7da54448-90c4-fb48-ac8e-\
280a6ce05a64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "SetDirectory", 
    "[", "\"\<C:\\\\Users\\\\azoma\\\\Documents\\\\GitHub\\\\Projektna-naloga-\
ROM\>\"", "]"}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9629573433114624`*^9, 3.9629573516516705`*^9}, 
   3.962957748237629*^9, {3.965379495083372*^9, 3.9653795051233635`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"24d7b206-1634-c941-b48b-69d068195e16"],

Cell["Shranimo podatke. Vemo, da so podatki lo\[CHacek]eni z \
podpi\[CHacek]ji.", "Text",
 CellChangeTimes->{{3.965379520156933*^9, 
  3.9653795396125336`*^9}},ExpressionUUID->"e19a3c1d-1413-1a4c-9876-\
7035005724f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"\"\<data.csv\>\"", ",", "\"\<Table\>\"", ",", 
     RowBox[{"\"\<FieldSeparators\>\"", "->", 
      RowBox[{"{", "\"\<;\>\"", "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.962955779965828*^9, 3.9629558006859283`*^9}, {
   3.9629559771174984`*^9, 3.962956029386175*^9}, {3.962956060664633*^9, 
   3.9629560615355034`*^9}, {3.962956158160681*^9, 3.962956171994381*^9}, {
   3.962956209922062*^9, 3.9629562573198204`*^9}, {3.9629563008767166`*^9, 
   3.9629563019474564`*^9}, 3.9629563422571297`*^9, 3.962956393995514*^9, {
   3.9629564286886387`*^9, 3.962956431838854*^9}, {3.962957328151758*^9, 
   3.9629573562145653`*^9}, {3.9653795655478916`*^9, 3.965379576940382*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"34d18330-7be7-aa4c-9037-7bac305b12fc"],

Cell["\<\
Tukaj si pripravim podatke za kasnej\[SHacek]o obdelavo (risanje na graf, ra\
\[CHacek]unanje volatilnosti ...). Vsi podatki so narobe urejeni, zato jih \
obrnem.\
\>", "Text",
 CellChangeTimes->{{3.9653795501674423`*^9, 3.9653795618112736`*^9}, {
  3.965379658247713*^9, 
  3.9653797426079655`*^9}},ExpressionUUID->"72fe45a0-194d-c741-b1b0-\
3951e5a24866"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"datumi", " ", "=", " ", 
   RowBox[{"Reverse", "[", 
    RowBox[{"DateObject", " ", "/@", " ", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"2", " ", ";;"}], ",", " ", "4"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"datumiReal", " ", "=", " ", 
   RowBox[{"AbsoluteTime", " ", "/@", " ", "datumi"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cene", " ", "=", " ", 
   RowBox[{"Reverse", "[", 
    RowBox[{"ToExpression", " ", "/@", " ", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"2", " ", ";;"}], ",", " ", "9"}], "]"}], "]"}], ",", " ", 
       RowBox[{"\"\<,\>\"", " ", "->", " ", "\"\<.\>\""}]}], "]"}]}], "]"}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.962955863487875*^9, 3.962955870155449*^9}, 
   3.9629573581243896`*^9, {3.9629573905983753`*^9, 3.962957399169935*^9}, {
   3.9629579813364105`*^9, 3.962957981711611*^9}, {3.9629702003666344`*^9, 
   3.9629702181004066`*^9}, {3.9653797546058617`*^9, 3.9653797787139015`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"5ec4ea37-4170-5748-b33f-9ac875b4c9eb"],

Cell["\<\
Pridobim podatke iz wolframove zbirke podatkov za eurostock in sp500.\
\>", "Text",
 CellChangeTimes->{{3.9654551056563053`*^9, 
  3.9654551246447887`*^9}},ExpressionUUID->"b1b262c2-ee3d-7541-b8cb-\
4681ea4b4a16"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sp500", "=", 
   RowBox[{"FinancialData", "[", 
    RowBox[{"\"\<^GSPC\>\"", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2018", ",", "1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2018", ",", "12", ",", "31"}], "}"}], ",", "\"\<Day\>\""}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dax", "=", 
   RowBox[{"FinancialData", "[", 
    RowBox[{"\"\<^GDAXI\>\"", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2018", ",", "1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2018", ",", "12", ",", "31"}], "}"}], ",", "\"\<Day\>\""}], 
      "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9654550343453445`*^9, 3.9654550730099163`*^9}, {
  3.9654554799980927`*^9, 3.9654554845119133`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"d591469e-ea95-c44a-928d-4d1a01218e84"],

Cell["Normalizacija", "Text",
 CellChangeTimes->{{3.965455130313772*^9, 
  3.9654551395612583`*^9}},ExpressionUUID->"f87ac357-8cc2-b84c-b41e-\
ef5bc240cc5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"normaliziraj", "[", "data_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
        RowBox[{"343", 
         RowBox[{"c", "/", 
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}]}], "}"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"petg", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"datumi", ",", " ", "cene"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965455143781273*^9, 3.9654552877438793`*^9}, {
  3.965455739841997*^9, 3.965455759945524*^9}, {3.9654558099283657`*^9, 
  3.965455810218935*^9}, {3.9654558424340076`*^9, 3.965455843809553*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"221b9541-f16b-394b-ac34-32cd2f2e3d6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sp500norm", " ", "=", " ", 
   RowBox[{"normaliziraj", "[", 
    RowBox[{"Normal", "[", "sp500", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"daxnorm", " ", "=", " ", 
   RowBox[{"normaliziraj", "[", 
    RowBox[{"Normal", "[", "dax", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965455257526451*^9, 3.965455261490204*^9}, {
  3.9654552919722557`*^9, 3.9654552951581383`*^9}, {3.9654553707708206`*^9, 
  3.965455405128498*^9}, {3.9654554892969112`*^9, 3.965455536190962*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"d4016fc3-1ee2-304b-8578-7e79c1ecda53"]
}, Open  ]],

