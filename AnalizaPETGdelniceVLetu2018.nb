Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"povprecna", "=", 
    RowBox[{"Mean", "[", "cene", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DateListPlot", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"datumi", ",", "cene"}], "}"}], "]"}], ",", 
    RowBox[{"Joined", "->", "True"}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Gibanje cene PETG v letu 2018\>\""}], ",", 
    RowBox[{"ImageSize", "->", "Large"}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Thick", ",", 
        RowBox[{"InfiniteLine", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Min", "[", "datumi", "]"}], ",", "povprecna"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Max", "[", "datumi", "]"}], ",", "povprecna"}], "}"}]}],
           "}"}], "]"}]}], "}"}], "}"}]}]}], "]"}], "\n"}], "\n"}], "Input",
