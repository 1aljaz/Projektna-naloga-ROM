 CellChangeTimes->{3.965378155936201*^9, 3.9653924846138687`*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"35ddfb38-b2a3-3143-b1ab-eba9c18d3994"]
}, Open  ]],

