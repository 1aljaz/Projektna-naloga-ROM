Cell["\<\
Vidimo, da se je najbolj spla\[SHacek]alo kupiti S&P500, najmanj pa DAX.\
\>", "Text",
 CellChangeTimes->{{3.9654561319944534`*^9, 
  3.9654561520547657`*^9}},ExpressionUUID->"a2bff796-0b64-a64a-b551-\
b8906cd265b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dnevniDonosi", "[", "pairs_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Differences", "[", 
     RowBox[{"pairs", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "/", 
    RowBox[{"Most", "[", 
     RowBox[{"pairs", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"volatilnostf", "[", "pairs_", "]"}], ":=", 
    RowBox[{
     RowBox[{"StandardDeviation", "[", 
      RowBox[{"dnevniDonosi", "[", "pairs", "]"}], "]"}], "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Length", "[", "pairs", "]"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<PETG\>\"", "->", 
    RowBox[{"volatilnostf", "[", "petg", "]"}]}], ",", 
   RowBox[{"\"\<S&P500\>\"", "->", 
    RowBox[{"volatilnostf", "[", "sp500norm", "]"}]}], ",", 
   RowBox[{"\"\<DAX\>\"", "->", 
    RowBox[{"volatilnostf", "[", "daxnorm", "]"}]}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.9654560736576195`*^9, 3.9654560804152985`*^9}, 
   3.9654561568369694`*^9},ExpressionUUID->"a2dcfed5-38d2-f440-a8e9-\
9b199a33a159"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"PETG\"\>", "\[Rule]", "0.17131415988644413`"}], ",", 
   RowBox[{"\<\"S&P500\"\>", "\[Rule]", "0.1703045266894498`"}], ",", 
   RowBox[{"\<\"DAX\"\>", "\[Rule]", "0.15496129419785298`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9654560817686596`*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"86a5f542-9691-a142-b290-cdbee832c34b"]
}, Open  ]],

Cell["\<\
VIdimo, da je DAX najmanj volatilna in zaradi tega, najmanj tvegana. Najbolj \
je PETG.

Primerjava gibanja delnice PETG z indeksom S&P 500 in nem\[SHacek]kim \
indeksom DAX v letu 2018 poka\[ZHacek]e, da so vse tri nalo\[ZHacek]be leto \
zaklju\[CHacek]ile z negativnim donosom. Delnica PETG je izgubila \[Dash]9,6 \
% vrednosti, kar je nekoliko ve\[CHacek] kot padec indeksa S&P 500 \
(\[Dash]7,0 %), a manj kot padec nem\[SHacek]kega indeksa DAX (\[Dash]18,0 \
%). To ka\[ZHacek]e, da se je PETG gibal podobno kot \[SHacek]ir\[SHacek]i \
trgi, vendar z nekoliko ve\[CHacek]jo ob\[CHacek]utljivostjo, pri \
\[CHacek]emer je bil padec manj izrazit kot pri DAX-u, a ve\[CHacek]ji kot \
pri ameri\[SHacek]kem trgu.\
\>", "Text",
 CellChangeTimes->{{3.9654561765329113`*^9, 3.965456210149952*^9}, {
  3.965456785308584*^9, 
  3.9654567861477737`*^9}},ExpressionUUID->"d039d869-0177-cf45-b3b5-\
6f8918958a5e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Kupec, ki naklju\[CHacek]no kupuje in prodaja", "Section",
 CellChangeTimes->{{3.965380599398432*^9, 
  3.9653806110139484`*^9}},ExpressionUUID->"0b479f29-cb8c-d64a-bd2e-\
4e0e67d652c9"],

Cell["\<\
V tem delu bom simuliral kupca, ki naklju\[CHacek]no kupuje in prodaja \
delnice. Na koncu bom dobi\[CHacek]ek/izgubo od vsake prodaje se\[SHacek]tel, \
da vidimo ali se je v delnico spla\[CHacek]alo vlagati.\
\>", "Text",
 CellChangeTimes->{{3.965380627866564*^9, 
  3.965380700028389*^9}},ExpressionUUID->"a105e0d0-dd3c-e741-9ebb-\
b5acaf1f7b0f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nakupi", "=", 
    RowBox[{"RandomSample", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", 
        RowBox[{
         RowBox[{"Length", "[", "cene", "]"}], "-", "6"}]}], "]"}], ",", 
      "10"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"transakcije", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kup", "=", "k"}], ",", "prod"}], "}"}], ",", 
        RowBox[{
         RowBox[{"prod", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"kup", "+", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"1", ",", "150"}], "}"}], "]"}]}], ",", " ", 
            RowBox[{"Length", "[", "datumi", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"prod", "<=", 
            RowBox[{"Length", "[", "cene", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"kup", ",", "prod"}], "}"}], ",", "Nothing"}], "]"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "nakupi"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rezultati", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kup", "=", 
           RowBox[{"t", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"prod", "=", 
           RowBox[{"t", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"datumi", "[", 
           RowBox[{"[", "kup", "]"}], "]"}], ",", 
          RowBox[{"cene", "[", 
           RowBox[{"[", "kup", "]"}], "]"}], ",", 
          RowBox[{"datumi", "[", 
           RowBox[{"[", "prod", "]"}], "]"}], ",", 
          RowBox[{"cene", "[", 
           RowBox[{"[", "prod", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"cene", "[", 
            RowBox[{"[", "prod", "]"}], "]"}], "-", 
           RowBox[{"cene", "[", 
            RowBox[{"[", "kup", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "transakcije"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"skupniDobicek", "=", 
    RowBox[{"Total", "[", 
     RowBox[{"rezultati", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Append", "[", 
      RowBox[{"rezultati", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Skupaj\>\"", ",", "\"\<\>\"", ",", "\"\<\>\"", 
         ",", "\"\<\>\"", ",", "skupniDobicek"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Datum nakupa\>\"", ",", "\"\<Cena nakupa\>\"", 
       ",", "\"\<Datum prodaje\>\"", ",", "\"\<Cena prodaje\>\"", 
       ",", "\"\<Dobi\[CHacek]ek\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9629581212536163`*^9, 3.9629581610324726`*^9}, 
   3.9629582006202927`*^9, 3.9629583025573063`*^9, {3.9629585930762043`*^9, 
   3.962958594196476*^9}, 3.9629586780189877`*^9, 3.962958730111351*^9, {
   3.962958768857996*^9, 3.9629587695055065`*^9}, {3.9629702370472126`*^9, 
