               RowBox[{"[", "#2", "]"}], "]"}]}], "}"}]}], "}"}], "]"}]}], 
        "}"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"kupIdx", ",", "prodIdx", ",", "segBarve"}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"DateListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"datumi", ",", "cene"}], "}"}], "]"}], ",", "kupTocke", ",", 
     "prodTocke"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "->", 
    RowBox[{"{", 
