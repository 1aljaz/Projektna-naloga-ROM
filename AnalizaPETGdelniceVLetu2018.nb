Cell["\<\
Vidimo, da so vsi (PETG, S&P 500, DAX) v drugi polovici leta padli. Sicer sta \
PETG in DAX, ki sta evropska, padla najve\[CHacek], medtem ko je S&P 500, ki \
je amri\[SHacek]ki, \[SHacek]e nekoliko zdr\[ZHacek]al padec.
Letni donos vseh treh delnic:\
\>", "Text",
 CellChangeTimes->{{3.9654558563136387`*^9, 3.9654559304990215`*^9}, {
  3.9654559965727444`*^9, 
  3.9654560087297554`*^9}},ExpressionUUID->"d14acfdc-9261-a444-8bf4-\
05be1b4dd54e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"donosi", "[", "pairs_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{"pairs", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "/", 
      RowBox[{"First", "[", 
       RowBox[{"pairs", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "-", "1"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<PETG\>\"", "->", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"100", "*", 
       RowBox[{"donosi", "[", "petg", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "1"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"\"\<S&P500\>\"", "->", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"100", "*", 
       RowBox[{"donos", "[", "sp500norm", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "1"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"\"\<DAX\>\"", "->", 
    RowBox[{"NumberForm", "[", 
     RowBox[{
      RowBox[{"100", "*", 
       RowBox[{"donosi", "[", "daxnorm", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "1"}], "}"}]}], "]"}]}]}], "}"}], "\n"}], "Input",
 CellChangeTimes->{{3.9654560109764595`*^9, 3.9654560109764595`*^9}, {
  3.9654560460401764`*^9, 3.9654560518248386`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"ce641734-7e84-b043-8a81-5672a149dd22"],

