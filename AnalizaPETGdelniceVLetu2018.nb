Cell[BoxData[{
 RowBox[{
  RowBox[{"kupIdx", "=", 
   RowBox[{"transakcije", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prodIdx", "=", 
    RowBox[{"transakcije", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"kupTocke", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"datumi", "[", 
       RowBox[{"[", "kupIdx", "]"}], "]"}], ",", 
      RowBox[{"cene", "[", 
       RowBox[{"[", "kupIdx", "]"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prodTocke", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"datumi", "[", 
        RowBox[{"[", "prodIdx", "]"}], "]"}], ",", 
       RowBox[{"cene", "[", 
        RowBox[{"[", "prodIdx", "]"}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dobicki", "=", 
   RowBox[{
    RowBox[{"cene", "[", 
     RowBox[{"[", "prodIdx", "]"}], "]"}], "-", 
    RowBox[{"cene", "[", 
     RowBox[{"[", "kupIdx", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"segBarve", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"#", ">=", "0"}], ",", 
       RowBox[{"Darker", "[", "Green", "]"}], ",", "Red"}], "]"}], "&"}], "/@",
     "dobicki"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"segCrte", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#3", ",", "Thick", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
