Cell["\<\
Vidimo, da je bil 102. dan v letu najbolj donosen, najmanj pa 150.
Vidimo, da je imela delnica 17.13% letno volatilnost, kar je \[SHacek]e \
zmerno.\
\>", "Text",
 CellChangeTimes->{{3.9653802047452183`*^9, 3.9653802566961727`*^9}, {
  3.965380375356989*^9, 
  3.9653804285470695`*^9}},ExpressionUUID->"b2de9aed-34f4-704b-ba28-\
5d898f011240"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"volatilnost", " ", "=", " ", 
  RowBox[{"StandardDeviation", "[", "donos", "]"}]}]], "Input",
 CellChangeTimes->{{3.96537813465786*^9, 3.965378155248497*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"83bf2e9f-2048-be49-a62c-56b58b92abc9"],

